# Vercel ne sert que la maquette : api/index.py + colette/demo_site.py + widget.js
# (sans requirements.txt, rien n'est installé : la maquette n'utilise que la bibliothèque standard)
*
!api
!api/index.py
!colette
!colette/__init__.py
!colette/demo_site.py
!colette/free_logo.svg
!colette/free_favicon.svg
!colette/static
!colette/static/widget.js
!vercel.json
