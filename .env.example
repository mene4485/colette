# Copier en colette/.env (ou .env à la racine) et remplir.
HAI_API_KEY=
# Optionnel : chemin de Chrome s'il n'est pas trouvé tout seul
# (Windows : C:\Program Files\Google\Chrome\Application\chrome.exe)
CHROME_PATH=
# Optionnel : modèle Holo (défaut côté H : holo4-27b ; plus rapide : holo4-35b-a3b)
HAI_MODEL=

# Étapes suivantes (bot vocal)
GLADIA_API_KEY=
OPENROUTER_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
# Optionnel : modèle OpenRouter du dialogue (défaut : google/gemini-2.5-flash)
OPENROUTER_MODEL=
# 1 = on peut couper la parole à Colette (casque obligatoire : pas d'anti-écho matériel)
COLETTE_BARGE_IN=0
